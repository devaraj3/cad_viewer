{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",        // 🔄 was "Node", change to "Bundler" for Vite
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "types": ["react", "react-dom", "vite/client"]  // vite/client covers CSS/asset imports + import.meta
  },
  "include": ["src", "index.html"],       // 🔄 simpler include, enough for Vite
  "exclude": ["node_modules"]
}
